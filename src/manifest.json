{
  "$schema": "https://json.schemastore.org/chrome-manifest",
  "name": "Prompt Archive for AI Chats",
  "version": "1.0.0",
  "description": "Automatically archives the prompts you send on ChatGPT, Claude.ai, Gemini and AI Studio to Markdown files on your PC, and exports chats. Developed by Rahil Qureshi; based on Chat Export by Trifall (MIT).",
  "manifest_version": 3,
  "minimum_chrome_version": "121",
  "browser_specific_settings": {
    "gecko": {
      "id": "prompt-archive@rahilqureshi",
      "strict_min_version": "109.0",
      "data_collection_permissions": {
        "required": [
          "none"
        ]
      }
    }
  },
  "icons": {
    "128": "icon.png"
  },
  "permissions": [
    "storage",
    "clipboardWrite",
    "clipboardRead",
    "nativeMessaging"
  ],
  "host_permissions": [
    "https://chat.openai.com/*",
    "https://chatgpt.com/*"
  ],
  "content_scripts": [
    {
      "matches": [
        "https://chat.openai.com/*",
        "https://chatgpt.com/*",
        "https://claude.ai/*",
        "https://aistudio.google.com/*",
        "https://gemini.google.com/*"
      ],
      "js": [
        "content.ts"
      ],
      "css": [
        "styles/content.css"
      ],
      "run_at": "document_end"
    }
  ],
  "action": {
    "default_popup": "pages/popup.html",
    "default_icon": "icon.png"
  },
  "options_ui": {
    "page": "pages/options.html",
    "open_in_tab": true
  },
  "key": "",
  "background": {
    "service_worker": "background.ts",
    "type": "module"
  },
  "short_name": "Prompt Archive",
  "author": "Rahil Qureshi"
}
